# ---- LLM ----
# The provider is picked from the model name: claude-* -> Anthropic, gpt-* -> OpenAI.
# Only the keys of the providers you use are required.
LLM_MODEL=claude-opus-5-5            # e.g. claude-sonnet-5-5, gpt-6.1-sol, gpt-5.6-sol
GUARDRAIL_MODEL=claude-haiku-4-5     # e.g. gpt-6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Airflow (via SSH tunnel: ssh -N -L 8080:localhost:8081 ubuntu@<vm-ip>) ----
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=agent_viewer        # Viewer role: read-only
AIRFLOW_PASSWORD=

# ---- AWS (keys live in ~/.aws/credentials, never here) ----
AWS_PROFILE=pipeline-copilot         # read-only IAM user
AWS_REGION=us-west-2
ATHENA_WORKGROUP=pipeline-copilot    # 1 GB per-query scan limit
ATHENA_DATABASE=weather_seismic

# ---- Local storage ----
CHROMA_PATH=./.chroma
MEMORY_DB=./memory.sqlite

# ---- Tracing (LangSmith) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pipeline-copilot

