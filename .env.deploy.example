# Settings for the hosted container. Copy to .env.deploy on the VM and fill in.
# .env.deploy is git-ignored: it holds secrets.

# ---- LLM ----
LLM_MODEL=claude-opus-5-5
GUARDRAIL_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Owner login (live questions) ----
# Long random password. Generate a secret with: openssl rand -hex 32
COPILOT_PASSWORD=
COPILOT_SECRET=

# ---- Airflow: same Docker network, no SSH tunnel ----
AIRFLOW_BASE_URL=http://airflow:8080
AIRFLOW_USERNAME=agent_viewer
AIRFLOW_PASSWORD=

# ---- AWS: profile from the mounted ~/.aws-copilot (read-only IAM user) ----
AWS_PROFILE=pipeline-copilot
AWS_REGION=us-west-2
ATHENA_WORKGROUP=pipeline-copilot
ATHENA_DATABASE=weather_seismic

# ---- Storage: the /data volume ----
CHROMA_PATH=/data/chroma
MEMORY_DB=/data/memory.sqlite

# ---- Ops: live views of the host (no secrets) ----
LAKE_DIR=/lake
DOCKER_API_URL=http://docker-proxy:2375
DASHBOARD_API_URL=http://api:8000
DASHBOARD_PUBLIC_URL=https://weather-seismic.duckdns.org
EXPECTED_CONTAINERS=kafka,producer,weather-stream,seismic-stream,airflow,airflow-postgres,api,web
GLUE_JOB_NAME=curate-daily
# One memory/CPU/disk snapshot per monitor pass (7 days kept), read by get_resource_history
RESOURCE_HISTORY=/data/resources.jsonl

# ---- Remediation: approved fixes (off unless ACTIONS_ENABLED=true) ----
# Fixes are always PROPOSED; with this on, the owner can approve them in live mode or the
# CLI and the agent runs them, then checks they worked. The monitor never self-approves.
ACTIONS_ENABLED=false
# A second Airflow user for writes, separate from agent_viewer. Give it a custom role with
# only: DAG Runs (create, edit), Task Instances (edit) on daily_lake_maintenance.
AIRFLOW_ACTIONS_USERNAME=agent_operator
AIRFLOW_ACTIONS_PASSWORD=
# Restart-only Docker proxy (docker-actions-proxy in docker-compose.yml)
DOCKER_ACTIONS_URL=http://docker-actions-proxy:2375
# Every attempted action, allowed or refused, is appended here
ACTIONS_AUDIT_LOG=/data/actions_audit.jsonl

# ---- Health monitor: free checks every 30 min, AI investigation only on a new failure ----
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=30
MONITOR_MAX_INVESTIGATIONS_PER_DAY=3
PUBLIC_URL=https://pipeline-copilot.duckdns.org
# Where alerts go (optional): a Slack or Discord webhook, or an ntfy topic URL for phone
# notifications, e.g. https://ntfy.sh/<long-random-topic-name>
ALERT_WEBHOOK_URL=

# ---- Tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pipeline-copilot
